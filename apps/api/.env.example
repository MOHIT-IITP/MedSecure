# ==============================================================================
# MedSecure API Environment Configuration
# ==============================================================================

# Server Port
PORT=4000

# Environment: development | production | test
NODE_ENV=development

# ------------------------------------------------------------------------------
# Supabase PostgreSQL Database Connection
# ------------------------------------------------------------------------------
# In Supabase:
# 1. Session pooler connection (Port 6543) - Recommended for API runtime:
#    postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# 2. Direct connection (Port 5432) - Recommended for DDL schema migrations:
#    postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.example:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# JWT Secret for signing session tokens (must be at least 16 characters)
JWT_SECRET=replace-with-a-secure-random-secret-key-at-least-32-chars

# Permitted CORS Origins (Credentialed requests allowed only from these origins)
DOCS_ORIGIN=http://localhost:3001
WEB_ORIGIN=http://localhost:3000

# HTTP-Only Cookie Security (set to true in production over HTTPS)
COOKIE_SECURE=false

# Permit API to start without a valid DATABASE_URL for offline liveness development / testing
ALLOW_OFFLINE_DEV=false
