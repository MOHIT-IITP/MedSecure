# MedSecure Monorepo Root Environment Configuration Reference
# See apps/api/.env.example for backend-specific settings.

PORT=4000
NODE_ENV=development

# Database Configuration (Supabase PostgreSQL)
# Direct connection for migrations: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
# Session pooler connection for application runtime: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL= postgresql://postgres:supabase@123
# Authentication
JWT_SECRET=super-secret-jwt-key-min-32-characters-long

# CORS Allowed Origins
DOCS_ORIGIN=http://localhost:3001
WEB_ORIGIN=http://localhost:3000

# Cookie Configuration
COOKIE_SECURE=false

# Development Offline Mode (set to true to test API liveness without needing live Supabase DB)
ALLOW_OFFLINE_DEV=false
